{
  "plugins": {
    "entries": {
      "discord-workspace-router": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        },
        "config": {
          "agentId": "<agent-id>",
          "workspaceDir": "/path/to/openclaw/workspace",
          "tokenEnv": "DISCORD_BOT_TOKEN",
          "autoRegister": true,
          "updateNames": true,
          "createReadme": true,
          "injectContext": true,
          "allowUncategorized": false
        }
      }
    }
  }
}
